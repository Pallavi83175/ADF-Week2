{
	"name": "pl_ingest_weather_incremental",
	"properties": {
		"activities": [
			{
				"name": "GetWatermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 45,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT TOP 1 WatermarkValue FROM dbo.ETL_Watermark WHERE SourceSystem = 'SourceAPI' AND EntityName = 'Weather' ORDER BY LastRunUtc DESC",
						"queryTimeout": "00:05:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "watermark",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "GetWeatherLocations",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "GetWatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 45,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT LocationId, Latitude, Longitude, Timezone, TimezoneOffset FROM dbo.WeatherLocation WHERE Latitude IS NOT NULL AND Longitude IS NOT NULL ORDER BY LocationId",
						"queryTimeout": "00:05:00",
						"partitionOption": "None"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEachLocation",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "GetWeatherLocations",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('GetWeatherLocations').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "GetWeatherAPI",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 4,
								"retryIntervalInSeconds": 45,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"httpRequestTimeout": "00:05:00",
									"requestInterval": "00.00:00:00.100",
									"requestMethod": "GET"
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "RestResource1",
									"type": "DatasetReference",
									"parameters": {
										"lat": {
											"value": "@string(item().Latitude)",
											"type": "Expression"
										},
										"lon": {
											"value": "@string(item().Longitude)",
											"type": "Expression"
										},
										"appid": {
											"value": "@pipeline().parameters.appid",
											"type": "Expression"
										},
										"units": {
											"value": "@pipeline().parameters.units",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "Json1",
									"type": "DatasetReference"
								}
							]
						},
						{
							"name": "CopyRawToStaging",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "GetWeatherAPI",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 4,
								"retryIntervalInSeconds": 45,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"mappings": [
										{
											"source": {
												"path": "$['dt']"
											},
											"sink": {
												"name": "dt"
											}
										},
										{
											"source": {
												"path": "$['coord']['lat']"
											},
											"sink": {
												"name": "Latitude"
											}
										},
										{
											"source": {
												"path": "$['coord']['lon']"
											},
											"sink": {
												"name": "Longitude"
											}
										},
										{
											"source": {
												"path": "$['timezone']"
											},
											"sink": {
												"name": "TimezoneOffset"
											}
										},
										{
											"source": {
												"path": "$['sys']['sunrise']"
											},
											"sink": {
												"name": "Sunrise"
											}
										},
										{
											"source": {
												"path": "$['sys']['sunset']"
											},
											"sink": {
												"name": "Sunset"
											}
										}
									]
								}
							},
							"inputs": [
								{
									"referenceName": "Json1",
									"type": "DatasetReference"
								}
							]
						}
					]
				}
			},
			{
				"name": "SetStagingAudit",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "ForEachLocation",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 3,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "UPDATE dbo.stg_Weather SET IngestTs = COALESCE(IngestTs, SYSUTCDATETIME()), SourceFile = COALESCE(SourceFile, 'weather.json') WHERE IngestTs IS NULL OR SourceFile IS NULL;"
						}
					],
					"scriptBlockExecutionTimeout": "00:05:00"
				}
			},
			{
				"name": "MergeToCurated",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SetStagingAudit",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 45,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "dbo.usp_MergeWeather"
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "UpdateWatermark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "MergeToCurated",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 4,
					"retryIntervalInSeconds": 45,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "dbo.usp_UpdateWatermark",
					"storedProcedureParameters": {
						"SourceSystem": {
							"value": "SourceAPI"
						},
						"EntityName": {
							"value": "Weather"
						},
						"NewWatermark": {
							"value": {
								"value": "@utcnow()",
								"type": "Expression"
							}
						},
						"RowsExtracted": {
							"value": {
								"value": "@activity('CopyRawToStaging').output.rowsCopied",
								"type": "Expression"
							}
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"appid": {
				"type": "String",
				"defaultValue": "pl_ingest_weather_incremental"
			},
			"units": {
				"type": "String",
				"defaultValue": "metric"
			}
		},
		"annotations": [
			"Project1",
			"Weather",
			"REST",
			"ADLS",
			"ForEach",
			"Staging",
			"Curated",
			"Watermark"
		]
	}
}