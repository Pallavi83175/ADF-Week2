{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "CustomersSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_ADLS_Customers_Target",
						"type": "DatasetReference"
					},
					"name": "CustomersSink"
				}
			],
			"transformations": [],
			"scriptLines": [
				"parameters{",
				"     pSourceSchema as string ('dbo'),",
				"     pSourceTable as string ('Customers'),",
				"     pTargetPath as string ('raw/customers'),",
				"     pLoadType as string ('FULL'),",
				"     pWatermarkColumn as string ('')",
				"}",
				"source(output(",
				"          CustomerID as integer,",
				"          FirstName as string,",
				"          LastName as string,",
				"          Email as string,",
				"          City as string,",
				"          Country as string,",
				"          CreatedDate as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> CustomersSource",
				"CustomersSource sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> CustomersSink"
			]
		}
	}
}